[Unit]
Description=Hermes GPT restricted ChatGPT MCP sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jfroh/.hermes/worktrees/hermes-file-bridge
Environment="PYTHONPATH=/home/jfroh/.hermes/hermes-agent"
Environment="HERMES_GPT_READ_ONLY=1"
Environment="HERMES_GPT_OPERATOR_ENABLED=1"
Environment="HERMES_GPT_OPERATOR_LEVEL=read_only"
Environment="HERMES_GPT_OPERATOR_APPLY_MODE=dry_run"
Environment="HERMES_GPT_OPERATOR_ALLOWED_PROFILES=default"
Environment="HERMES_GPT_OPERATOR_ALLOWED_PATHS=/home/jfroh/.hermes/ops-brain,/home/jfroh/.hermes/worktrees/hermes-file-bridge"
ExecStart=/home/jfroh/hermes-gpt/.venv/bin/python /home/jfroh/.hermes/worktrees/hermes-file-bridge/server.py --http --profile chatgpt-restricted --host 127.0.0.1 --port 7677
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/jfroh/.hermes/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=default.target
