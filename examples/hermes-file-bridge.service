[Unit]
Description=Hermes asynchronous file-bridge worker
After=hermes-gateway.service hermes-gpt-sidecar.service
Wants=hermes-gateway.service hermes-gpt-sidecar.service

[Service]
Type=simple
WorkingDirectory=/home/jfroh/hermes-gpt
Environment="HERMES_GPT_BRIDGE_ROOT=/home/jfroh/.hermes/bridge"
Environment="HERMES_GPT_OPERATOR_ENABLED=1"
Environment="HERMES_GPT_OPERATOR_LEVEL=owner"
Environment="HERMES_GPT_OPERATOR_APPLY_MODE=direct"
Environment="HERMES_GPT_OWNER_ACK=I_UNDERSTAND_THIS_CAN_MUTATE_MY_MACHINE"
Environment="HERMES_GPT_OPERATOR_ALLOWED_PROFILES=default"
Environment="HERMES_GPT_OPERATOR_ALLOWED_PATHS=/home/jfroh/.hermes/bridge,/home/jfroh/hermes-gpt"
ExecStart=/home/jfroh/hermes-gpt/.venv/bin/python /home/jfroh/hermes-gpt/bridge_worker.py --root /home/jfroh/.hermes/bridge --workdir /home/jfroh/hermes-gpt --profile default --max-turns 30 --timeout 600
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
